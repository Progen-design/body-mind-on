# Ulozene AI transkripty - nikdy necommitovat.
# .specstory melo 127 MB a 149 sledovanych souboru ve verejnem repozitari,
# vcetne realne vypadajicich Supabase credentials v textu konverzaci.
.specstory/
.aider*
.claude/history/
.cursor/chat/

# build a nastroje - nikdy necommitovat
.next/
.vercel/
.cache/
.local/
tmp/
apps/*/.next/
apps/*/dist/
apps/*/node_modules/

# Plosne *.sql vyse by tise vyradilo kazdou novou migraci. Existujici jsou
# v gitu jen proto, ze se kdysi pridaly silou. Vyjimka tomu zabrani.
!supabase/migrations/*.sql
# Odlozene migrace (napsane, ale zatim vedome NEAPLIKOVANE, cekaji na
# samostatnou kontrolu — viz docs/DALSI_KROK.md). Bez tyhle vyjimky by
# plosne *.sql vyse soubor v podadresari tise vyradilo z gitu a "NEMAZ,
# jen odloz" by po prvnim pushi znamenalo "smazano".
!supabase/migrations/_odlozene/*.sql
.vercel
