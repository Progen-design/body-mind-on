{
      "env": {
            "PLAN_OUTPUT_MODE": "nutrition_training",
            "NEXT_PUBLIC_PLAN_OUTPUT_MODE": "nutrition_training"
      },
      "rewrites": [
            { "source": "/((?!api/).*)", "destination": "/index.html" }
      ],
      "crons": [
            {
                  "path": "/api/ai/run-coach-scheduler",
                  "schedule": "0 6 * * *"
            },
            {
                  "path": "/api/cron/withings-sync",
                  "schedule": "0 * * * *"
            },
            {
                  "path": "/api/cron/apple-health-daily-review",
                  "schedule": "0 5 * * *"
            },
            {
                  "path": "/api/cron/lifecycle-email",
                  "schedule": "0 * * * *"
            },
            {
                  "path": "/api/cron/system-health-alert",
                  "schedule": "30 7 * * *"
            },
            {
                  "path": "/api/cron/daily-adherence-sync",
                  "schedule": "30 22 * * *"
            },
            {
                  "path": "/api/cron/shopping-normalize-audit",
                  "schedule": "0 4 * * *"
            },
            {
                  "path": "/api/cron/import-spoonacular",
                  "schedule": "0 3 * * *"
            },
            {
                  "path": "/api/cron/inactivity-reminder",
                  "schedule": "0 16 * * *"
            },
            {
                  "path": "/api/cron/translate-recipes",
                  "schedule": "*/5 * * * *"
            },
            {
                  "path": "/api/cron/import-exercises",
                  "schedule": "45 2 * * *"
              },
              {
                  "path": "/api/cron/generate-recipes",
                  "schedule": "15 3,11,19 * * *"
              },
              {
                  "path": "/api/cron/sweep-catalog-activation",
                  "schedule": "30 3 * * *"
            },
            {
                  "path": "/api/cron/weekly-plan-producer",
                  "schedule": "0 4 * * *"
            }
      ],
      "functions": {
            "api/ai/run-scheduler.js": {
                  "maxDuration": 300
            },
            "api/ai/run-coach-scheduler.js": {
                  "maxDuration": 120
            },
            "api/body-metrics.js": {
                  "maxDuration": 90
            },
            "api/cron/withings-sync.js": {
                  "maxDuration": 300
            },
            "api/cron/lifecycle-email.js": {
                  "maxDuration": 120
            },
            "api/cron/apple-health-daily-review.js": {
                  "maxDuration": 300
            },
            "api/cron/system-health-alert.js": {
                  "maxDuration": 60
            },
            "api/cron/daily-adherence-sync.js": {
                  "maxDuration": 120
            },
            "api/cron/shopping-normalize-audit.js": {
                  "maxDuration": 120
            },
            "api/cron/import-spoonacular.js": {
                  "maxDuration": 300
            },
            "api/cron/translate-recipes.js": {
                  "maxDuration": 120,
                  "includeFiles": "prompts/**"
            },
            "api/admin/import-spoonacular.js": {
                  "maxDuration": 300
            },
            "api/admin/translate-recipes.js": {
                  "maxDuration": 120,
                  "includeFiles": "prompts/**"
            }
      }
}
